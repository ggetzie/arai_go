# /usr/local/src/arai_go/arai.env  (owner arai_user, mode 0600)
# Read by systemd's EnvironmentFile= and by `arai <cmd> -env`. No variable
# expansion or quoting is needed; bcrypt hashes containing $ are fine as-is.

# Either a full URL...
# DATABASE_URL=postgres://arai_user:PASSWORD@localhost/DBNAME
# ...or the same keys the Django .env used:
DB_NAME=
DB_USER=
arai_DB_PW=

ARAI_ADDR=127.0.0.1:8007
# openssl rand -base64 48
ARAI_SECRET_KEY=
ARAI_ADMIN_USER=
# arai hashpw
ARAI_ADMIN_PASSWORD_HASH=

# Reddit posting (arai post reddit): the Django .env keys for the "script" app.
arai_Reddit_id=
arai_Reddit_secret=
arai_Reddit_username=
arai_Reddit_password=
# Optional: ARAI_REDDIT_SUBREDDIT (default AskRedditButAI), ARAI_REDDIT_USER_AGENT

# X posting (arai post x): OAuth 1.0a keys of a pay-per-use X app with
# Read and Write permission.
arai_Twitter_API_key=
arai_Twitter_API_secret_key=
arai_Twitter_access_token=
arai_Twitter_access_token_secret=
