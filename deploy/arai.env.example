# /usr/local/src/askreddit_but_ai/go/arai.env  (owner arai_user, mode 0600)
# Read by systemd's EnvironmentFile= and by `arai <cmd> -env`. No variable
# expansion or quoting is needed; bcrypt hashes containing $ are fine as-is.

# Either a full URL...
# DATABASE_URL=postgres://arai_user:PASSWORD@localhost/DBNAME
# ...or the same keys the Django .env used:
DB_NAME=
DB_USER=
arai_DB_PW=

ARAI_ADDR=127.0.0.1:8007
# openssl rand -base64 48
ARAI_SECRET_KEY=
ARAI_ADMIN_USER=
# arai hashpw
ARAI_ADMIN_PASSWORD_HASH=
